ENVIRONMENT=development
POSTGRES_DB=jain
POSTGRES_USER=jain
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://jain:local-development-only@127.0.0.1:5432/jain
STORAGE_PATH=storage/private
# Generate a random secret with secrets.token_urlsafe(48). Never commit .env.
AUTH_SECRET=
# Development mode returns development_otp in the OTP request response.
# Production requires ENVIRONMENT=production and OTP_DELIVERY=smtp.
OTP_DELIVERY=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
